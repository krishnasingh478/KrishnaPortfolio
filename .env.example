# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Connection URI)
# For local MongoDB: mongodb://127.0.0.1:27017/krishna_portfolio
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/krishna_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/krishna_portfolio

# Session Configuration
SESSION_SECRET=change-this-to-a-very-secure-random-secret-key-in-production

# Administrator Initial Credentials (used when running 'npm run seed')
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@krishnasingh.dev
ADMIN_PASSWORD=AdminSecurePassword123!

# Client URL (for CORS if running separately)
CLIENT_URL=http://localhost:5000

